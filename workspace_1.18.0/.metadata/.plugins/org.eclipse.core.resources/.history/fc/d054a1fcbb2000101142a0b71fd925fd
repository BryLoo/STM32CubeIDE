int main(void) {

	HAL_Init();

	RCC->AHB2ENR |= RCC_AHB2ENR_GPIOCEN;
	GPIOC->MODER &= ~(GPIO_MODER_MODE0);
	GPIOC->MODER |= (GPIO_MODER_MODE0_0);
	GPIOC->OTYPER &= ~(GPIO_OTYPER_OT0);
	GPIOC->PUPDR &= ~(GPIO_PUPDR_PUPD0);
	GPIOC->OSPEEDR |= (3 << GPIO_OSPEEDR_OSPEED0_Pos);

	RCC->AHB2ENR |= RCC_AHB2ENR_GPIODEN;

//  SystemClock_Config();

//  MX_GPIO_Init();
	/* USER CODE BEGIN 2 */

	SysTick_Init();
	LCD_config();		// enables GPIO pins for LCD
	Keypad_Config();
	LCD_init();		// wake up + 4 bit set
	LCD_command(0x01);
	delay_us(2000);
	LCD_setcursor(0, 0);
	LCD_write_string("EE 329 A3 TIMER");
	LCD_setcursor(1, 0);
	LCD_write_string("*=SET #=GO 00:00");

	while (1) {
		if (Keypad_IsAnyKeyPressed()) {
			char key = Keypad_WhichKeyIsPressed();
			if (key == '*') {
				break;
			}
		}
	}

	char input_buffer[4] = { 0 };
	int input_index = 0;

	while (input_index < 4) {
		if (Keypad_IsAnyKeyPressed()) {
			char key = Keypad_WhichKeyIsPressed();

			switch (input_index) {
			case 0:
				if (key >= '0' && key <= '5') {
					input_buffer[input_index++] = key;
					LCD_setcursor(1, 11 + input_index - 1); //- shifts left, + shifts right
					LCD_write_char(key);
				}
				break;

			case 1:
				if (key >= '0' && key <= '9') {
					input_buffer[input_index++] = key;
					LCD_setcursor(1, 11 + input_index - 1); //- shifts left, + shifts right
					LCD_write_char(key);

					input_buffer[input_index++] = ':';
					LCD_setcursor(1, 11 + input_index - 1);
					LCD_write_char(':');

				}
				break;

			case 2:
				if (key >= '0' && key <= '5') {
					input_buffer[input_index++] = key;
					LCD_setcursor(1, 11 + input_index - 1); //- shifts left, + shifts right
					LCD_write_char(key);
				}
				break;

			case 3:
				if (key >= '0' && key <= '9') {
					input_buffer[input_index++] = key;
					LCD_setcursor(1, 11 + input_index - 1); //- shifts left, + shifts right
					LCD_write_char(key);
					input_buffer[input_index++] = 0;
				}
				break;
			}
			/*
			 if (key >= '0' && key<= '9'){
			 input_buffer[input_index++] = key;
			 if (input_index < 3) {
			 LCD_setcursor(1,11 + input_index - 1);   //- shifts left, + shifts right
			 LCD_write_char(key);
			 }
			 if (input_index == 2) {
			 LCD_setcursor(1,11 + input_index);
			 LCD_write_char(':');
			 }
			 if (input_index >= 3) {
			 LCD_setcursor(1,11 + input_index);   //- shifts left, + shifts right
			 LCD_write_char(key);
			 }
			 */
			while (Keypad_IsAnyKeyPressed())
				;
			delay_us(150000);

		}
	}

	while (1) {
		if (Keypad_IsAnyKeyPressed()) {
			char key = Keypad_WhichKeyIsPressed();
			if (key == '#')
				break;
		}
	}

	int mm = (input_buffer[0] - '0') * 10 + (input_buffer[1] - '0');
	int ss = (input_buffer[2] - '0') * 10 + (input_buffer[3] - '0');
	char time_buffer[10];

	while (mm > 0 || ss > 0) {
		if (Keypad_IsAnyKeyPressed()) {
			char key = Keypad_WhichKeyIsPressed();
			if (key == '*') {
				break;
			}
		}
		snprintf(time_buffer, sizeof(time_buffer), "%02d:%02d", mm, ss);
		LCD_setcursor(1, 11);
		LCD_write_string(time_buffer);
		delay_us(1000000);

		if (--ss < 0 || ss > 59) {
			ss = 59;
			mm--;
		}

	}

	LCD_setcursor(1, 11);
	LCD_write_string("00:00");
	LED_PORT->ODR |= LED_PIN;

	while (1) {
		if (Keypad_IsAnyKeyPressed()) {
			;
			char key = Keypad_WhichKeyIsPressed();
			if (key == '#') {
				LED_PORT->ODR &= ~LED_PIN;

			}
		}
	}

}

