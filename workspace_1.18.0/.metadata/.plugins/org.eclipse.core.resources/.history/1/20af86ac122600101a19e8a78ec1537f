#include "main.h"


#define TIMER_CLK      4000000UL    // 4 MHz
#define OUT_FREQ       5000UL       // 5 kHz
#define PERIOD_TICKS  (TIMER_CLK/OUT_FREQ)        // = 800
#define DUTY_TICKS    (PERIOD_TICKS*25/100)        // = 200


