void TIM2_IRQHandler(void) {
	if (TIM2->SR & TIM_SR_CC1IF) {      // triggered by CCR1 event ...
		TIM2->SR &= ~(TIM_SR_CC1IF);     // manage the flag
		GPIOA->BSRR = (1 << (5 + 16));        // <-- manage GPIO pin here
	}
	if (TIM2->SR & TIM_SR_UIF) {        // triggered by ARR event ...
		TIM2->SR &= ~(TIM_SR_UIF);       // manage the flag
		GPIOA->BSRR = (1 << 5);       // <-- manage GPIO pin here
	}
}

void GPIO_setup(void) {
//initialize LED GPIO
	RCC->AHB2ENR |= RCC_AHB2ENR_GPIOCEN; //enable clock for GPIO C
	GPIOC->MODER &= ~(GPIO_MODER_MODE0); //clear mode of pins
	GPIOC->MODER |= (GPIO_MODER_MODE0_0); //set mode of pins
	GPIOC->OTYPER &= ~(GPIO_OTYPER_OT0); //set output drive
	GPIOC->PUPDR &= ~(GPIO_PUPDR_PUPD0); //set pullup/pull-down resistors
	GPIOC->OSPEEDR |= (3 << GPIO_OSPEEDR_OSPEED0_Pos); //set speed
}


