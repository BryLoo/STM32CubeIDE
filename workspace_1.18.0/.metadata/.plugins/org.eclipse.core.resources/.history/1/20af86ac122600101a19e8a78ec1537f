void setup_TIM2(void) {
	// 1) Enable clocks
	RCC->APB1ENR1 |= RCC_APB1ENR1_TIM2EN;      // timer
	RCC->AHB2ENR |= RCC_AHB2ENR_GPIOAEN;      // GPIO port A

	// 2) Configure PA5 (for example) as push-pull output
	GPIOA->MODER &= ~(3 << (5 * 2));
	GPIOA->MODER |= (1 << (5 * 2));   // PA5 = General purpose output
	GPIOA->OTYPER &= ~(1 << 5);       // push-pull
	GPIOA->OSPEEDR |= (3 << (5 * 2));   // high speed (optional)

	// 3) Timer in up-counting mode, no prescaler
	TIM2->PSC = 0;                    // prescaler = 0 → clock still 4 MHz
	TIM2->ARR = PERIOD_TICKS - 1; // auto-reload = 799 → counts 0…799 = 800 ticks

	// 4) CCR1 = duty threshold
	TIM2->CCR1 = DUTY_TICKS;          // 200 ticks → 25 % of 800

	// 5) Enable capture/compare interrupt on CC1 and update interrupt
	TIM2->DIER = TIM_DIER_CC1IE | TIM_DIER_UIE;

	// 6) Clear any pending flags
	TIM2->SR &= ~(TIM_SR_CC1IF | TIM_SR_UIF);

	// 7) Enable TIM2 interrupt in NVIC
	NVIC->ISER[0] = (1 << (TIM2_IRQn & 31));

	// 8) Start timer
	TIM2->CR1 = TIM_CR1_CEN;
}
