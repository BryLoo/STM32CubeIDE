#ifndef INC_TIMER_H_
#define INC_TIMER_H_

#include "math.h"

#define DUTY_CYCLE 25
#define FREQ 5000


#define CLOCK_FREQ 4000000
#define LED_PORT GPIOC
#define LED_PIN GPIO_PIN_0

#define PERIOD ( (CLOCK_FREQ / FREQ) - 1 ) // 4MHz / 5kHz = 800, 800 - 1 = 799
#define MODIFIED_DUTY_CYCLE ( (100 - DUTY_CYCLE) * PERIOD) / 100 ) + 1


#endif /* INC_TIMER_H_ */
