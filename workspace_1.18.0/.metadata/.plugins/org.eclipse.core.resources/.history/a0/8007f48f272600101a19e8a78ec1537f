void GPIO_setup(void) {
    // enable clock for GPIO C
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOCEN;
    __NOP(); // small delay to let clock settle

    // we'll configure both PC0 and PC1
    const uint32_t pins   = (1u<<0) | (1u<<1);

    // 1) clear MODER bits for PC0 & PC1 (each has 2 bits)
    GPIOC->MODER &=
        ~( GPIO_MODER_MODE0
         | GPIO_MODER_MODE1 );

    // 2) set MODER to “01” = general-purpose output
    GPIOC->MODER |=
        ( GPIO_MODER_MODE0_0
         | GPIO_MODER_MODE1_0 );

    // 3) push-pull
    GPIOC->OTYPER &= ~pins;

    // 4) no pull-up / pull-down
    GPIOC->PUPDR &=
        ~( GPIO_PUPDR_PUPD0
         | GPIO_PUPDR_PUPD1 );

    // 5) high speed (11) for both pins:
    GPIOC->OSPEEDR |=
        (3u << GPIO_OSPEEDR_OSPEED0_Pos)
      | (3u << GPIO_OSPEEDR_OSPEED1_Pos);

    // 6) start them low
    GPIOC->ODR &= ~pins;
}

void setup_TIM2( int iDutyCycle ) {
   RCC->APB1ENR1 |= RCC_APB1ENR1_TIM2EN;           // enable clock for TIM2
   TIM2->DIER |= (TIM_DIER_CC1IE | TIM_DIER_UIE);  // enable event gen, rcv CCR1
   TIM2->ARR = PERIOD;                             // ARR = T = counts @4MHz
   TIM2->SR &= ~(TIM_SR_CC1IF | TIM_SR_UIF);       // clr IRQ flag in status reg
   NVIC->ISER[0] |= (1 << (TIM2_IRQn & 0x1F));     // set NVIC interrupt: 0x1F
   __enable_irq();                                 // global IRQ enable
   TIM2->CR1 |= TIM_CR1_CEN;                       // start TIM2 CR1
}
void TIM2_IRQHandler(void) {

	ISRTime_PORT->ODR |= ISRTime_PIN;

   if (TIM2->SR & TIM_SR_CC1IF) {      // triggered by CCR1 event ...
      TIM2->SR &= ~(TIM_SR_CC1IF);     // manage the flag
      LED_PORT->ODR ^= LED_PIN;        // <-- manage GPIO pin here
      TIM2 ->CCR1 += PERIOD;
   }

   ISRTime_PORT->ODR &= ~ISRTime_PIN;
}



