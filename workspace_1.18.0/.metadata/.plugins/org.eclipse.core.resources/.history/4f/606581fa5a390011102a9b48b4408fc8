/**
  * @brief  Function implementing the mytask thread.
  * @param  argument: Not used
  * @retval None
  */
/* USER CODE END Header_Blink_LED */
void Blink_LED(void *argument)
{
  /* USER CODE BEGIN 5 */
    /* Task 1: Moderate blink rate, 30 times, using CMSIS osDelay */
    for (int i = 0; i < 30; i++)
    {
        HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_SET);
        osDelay(250);   /* ON for 250 ms  -- uses CMSIS delay (FreeRTOS-based) */
        HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_RESET);
        osDelay(250);   /* OFF for 250 ms -- 50% duty cycle, ~2 Hz blink */
    }

    /* Create Task 2 from within this task (after scheduler has started) */
    blinkTask2Handle = osThreadNew(BlinkTask2, NULL, &blinkTask2_attr);

    /* Delete this task so it never runs again */
    vTaskDelete(NULL);
  /* USER CODE END 5 */
}

