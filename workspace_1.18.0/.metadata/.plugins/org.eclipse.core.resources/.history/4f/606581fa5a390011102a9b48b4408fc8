/* USER CODE BEGIN 4 */
/* Simple busy-wait delay (dumb delay) */
void dumb_delay(volatile uint32_t count)
{
    while (count--) {
        __NOP();
    }
}

/* ========================== */
/* Task 2: Blink 30 times at a faster rate using vTaskDelay (FreeRTOS delay) */
/* ========================== */
void BlinkTask2(void *argument)
{
    for (int i = 0; i < 30; i++)
    {
        HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_SET);
        vTaskDelay(pdMS_TO_TICKS(100));   /* ON for 100 ms  -- uses FreeRTOS delay */
        HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_RESET);
        vTaskDelay(pdMS_TO_TICKS(100));   /* OFF for 100 ms -- 50% duty cycle, ~5 Hz blink */
    }

    /* Create Task 3 */
    blinkTask3Handle = osThreadNew(BlinkTask3, NULL, &blinkTask3_attr);

    /* Delete this task */
    vTaskDelete(NULL);
}

/* ========================== */
/* Task 3: Heartbeat pattern 10 times, then LED stays on forever */
/* ========================== */
void BlinkTask3(void *argument)
{
    /*
     * Heartbeat pattern: two quick flashes followed by a longer pause.
     *   flash ON  -> short pause -> flash ON -> longer pause
     * This mimics a "lub-dub ... lub-dub" heartbeat rhythm.
     *
     * Using dumb_delay here for the short intra-beat timings.
     * You could also use osDelay/vTaskDelay since the tick period (1 ms)
     * is fine-grained enough, but using a dumb delay demonstrates the contrast.
     */
    for (int i = 0; i < 10; i++)
    {
        /* First beat ("lub") */
        HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_SET);
        dumb_delay(800000);  /* ~100 ms ON  (adjust count for your clock speed) */
        HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_RESET);
        dumb_delay(800000);  /* ~100 ms OFF */

        /* Second beat ("dub") */
        HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_SET);
        dumb_delay(800000);  /* ~100 ms ON */
        HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_RESET);

        /* Longer pause between heartbeats */
        osDelay(500);  /* 500 ms pause -- using CMSIS delay for the long gap */
    }

    /* LED stays on forever */
    HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_SET);

    /* Suspend this task (it has nothing left to do) */
    vTaskSuspend(NULL);
}
