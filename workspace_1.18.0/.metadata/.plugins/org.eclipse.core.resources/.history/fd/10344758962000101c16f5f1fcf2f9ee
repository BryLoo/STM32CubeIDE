#ifndef INC_LCD_H_
#define INC_LCD_H_

#include "main.h"
#include <stdint.h>

// LCD functions to be available for future projects
void LCD_config(void);

//////////////////////////////////////////////////////////////////////
void LCD_init(void);   	              // initialize LCD
void LCD_pulse_ENA(void);
void LCD_CursorBlinkOn(void);
void LCD_4b_command(uint8_t command);
void LCD_command(uint8_t command);   // send LCD a single 8-bit command
void LCD_write_char(uint8_t letter); // write a character to the LCD
//////////////////////////////////////////////////////////////////////
void LCD_write_string(const char*str); // printing a string to the LCD that's constant and won't be changed
void LCD_setcursor(uint8_t row, uint8_t col); // position to start writing on LCD
//defining port E for LCD
#define LCD_PORT GPIOE

//defining pin for RS RW E/N
#define LCD_PIN_RS GPIO_PIN_2
#define LCD_PIN_RW GPIO_PIN_3
#define LCD_PIN_EN GPIO_PIN_4

// defining things from professors provided code
#define LCD_DATA_BITS (0x0F << 5 ) //PE5 to PE8

// LCD commands from ST7066U data sheet
#define LCD_clear_display (0x01) // 0000x0001
#define LCD_set_cursor (0x10)
#define LCD_return_home (0x02) // 0000x0010
#define LCD_entry_mode_set (0x06) // 0000x0111
#define LCD_display_on (0x0F) // 0000x1111
#define LCD_function_set (0x28) // 0010x1000

//f. when the COUNTDOWN is complete turn ON an LED and leave it ON until the ‘#’ is pressed.
void LCD_countdown_led_on(void);

