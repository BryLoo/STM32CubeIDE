void GPIO_setup(void) {
    // initialize PC0 and PC1 the same way
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOCEN;                        // enable clock for GPIOC
    GPIOC->MODER  &= ~(GPIO_MODER_MODE0 | GPIO_MODER_MODE1);    // clear mode bits for PC0 & PC1
    GPIOC->MODER  |=  (GPIO_MODER_MODE0_0 | GPIO_MODER_MODE1_0); // set PC0 & PC1 to output (01)
    GPIOC->OTYPER &= ~(GPIO_OTYPER_OT0 | GPIO_OTYPER_OT1);      // push-pull on PC0 & PC1
    GPIOC->PUPDR  &= ~(GPIO_PUPDR_PUPD0 | GPIO_PUPDR_PUPD1);    // no pull-up/pull-down on PC0 & PC1
    GPIOC->OSPEEDR |= (3 << GPIO_OSPEEDR_OSPEED0_Pos)
                   |  (3 << GPIO_OSPEEDR_OSPEED1_Pos);          // high speed on PC0 & PC1
}


void setup_TIM2( int iDutyCycle ) {
   RCC->APB1ENR1 |= RCC_APB1ENR1_TIM2EN;           // enable clock for TIM2
   TIM2->DIER |= (TIM_DIER_CC1IE | TIM_DIER_UIE);  // enable event gen, rcv CCR1
   TIM2->ARR = PERIOD;                             // ARR = T = counts @4MHz
   TIM2->SR &= ~(TIM_SR_CC1IF | TIM_SR_UIF);       // clr IRQ flag in status reg
   NVIC->ISER[0] |= (1 << (TIM2_IRQn & 0x1F));     // set NVIC interrupt: 0x1F
   __enable_irq();                                 // global IRQ enable
   TIM2->CR1 |= TIM_CR1_CEN;                       // start TIM2 CR1
}

 //PART B
void TIM2_IRQHandler(void) {

	ISRTime_PORT->ODR |= ISRTime_PIN;

   if (TIM2->SR & TIM_SR_CC1IF) {      // triggered by CCR1 event ...
      TIM2->SR &= ~(TIM_SR_CC1IF);     // manage the flag
      LED_PORT->ODR ^= LED_PIN;        // <-- manage GPIO pin here
      TIM2 ->CCR1 += 0.5*PERIOD;
   }

   ISRTime_PORT->ODR &= ~ISRTime_PIN;
}

